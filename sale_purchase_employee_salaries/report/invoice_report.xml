<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        بنعمل نفس اللي عملناه في تقرير أمر البيع بالظبط: نضيف اسم الموظف
        كسطر صغير تحت وصف بند الفاتورة، عن طريق البحث على
        <span t-field="line.name"/> اللي موجود بثبات في قالب فاتورة أودو
        الأساسي (account.report_invoice_document) من سنين طويلة.
        ⚠️ لو فشل التثبيت بسبب السطر ده، احذف الملف ده من الموديول مؤقتًا
        (شيله من __manifest__.py data list) وثبّت الباقي عادي، وابعتلي
        رسالة الخطأ عشان أظبطه بنفس الطريقة اللي ظبطنا بيها الـ views قبل كده.
    -->
    <template id="report_invoice_document_employee_note" inherit_id="account.report_invoice_document">
        <xpath expr="//span[@t-field='line.name']" position="after">
            <div t-if="line.employee_id" class="text-muted" style="font-size: 0.85em;">
                الموظف: <span t-field="line.employee_id.name"/>
            </div>
        </xpath>
    </template>
</odoo>
