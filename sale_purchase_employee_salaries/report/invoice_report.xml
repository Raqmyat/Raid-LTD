<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- نفس منطق تقرير أمر البيع بالظبط، على قالب الفاتورة (متغير o بدل doc). -->
    <template id="report_invoice_document_employee_note" inherit_id="account.report_invoice_document">
        <xpath expr="//table[@name='invoice_line_table']" position="before">
            <t t-set="salary_matrix"
               t-value="o._get_salary_matrix() if o.is_salaries and o.payslip_run_id else {'columns': [], 'rows': [], 'rows_by_employee': {}}"/>
            <style t-if="o.is_salaries and o.payslip_run_id">
                [name='th_priceunit'], [name='td_price_unit'] { display: none; }
                .o_main_table th, .o_main_table td { padding: 3px 4px !important; font-size: 10px; }
            </style>
        </xpath>

        <xpath expr="//th[@name='th_subtotal']" position="before">
            <t t-if="o.is_salaries and o.payslip_run_id">
                <t t-foreach="salary_matrix['columns']" t-as="col">
                    <th class="text-end"><span t-esc="col['name']"/></th>
                </t>
            </t>
        </xpath>

        <xpath expr="//td[@name='td_subtotal']" position="before">
            <t t-if="o.is_salaries and o.payslip_run_id and line.employee_id">
                <t t-set="emp_row"
                   t-value="salary_matrix['rows_by_employee'].get(line.employee_id.id)"/>
                <t t-if="emp_row">
                    <t t-foreach="emp_row['values']" t-as="val">
                        <td class="text-end"><span t-esc="'%.2f' % val"/></td>
                    </t>
                </t>
                <t t-else="">
                    <t t-foreach="salary_matrix['columns']" t-as="col"><td/></t>
                </t>
            </t>
            <t t-elif="o.is_salaries and o.payslip_run_id">
                <t t-foreach="salary_matrix['columns']" t-as="col"><td/></t>
            </t>
        </xpath>
    </template>
</odoo>
