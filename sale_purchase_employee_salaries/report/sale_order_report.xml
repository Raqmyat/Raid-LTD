<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        نفس فكرة تقرير الفاتورة بالظبط. المتغير هنا برضه "o".
        ⚠️ الأسماء th_subtotal/td_subtotal/sale_order_line_table مبنية على
        نفس تسمية قالب الفاتورة (اللي أكدناها من الـ Technical View عندك)
        لكن معندناش تأكيد 100% إنها نفس الأسماء في sale.report_saleorder_document.
        لو فشل تثبيت الملف ده، احذفه من __manifest__.py مؤقتًا وثبّت الباقي،
        وابعتلي رسالة الخطأ (أو انسخلي arch الـ view زي ما عملنا مع الفاتورة)
        وهظبطه فورًا.
    -->
    <template id="report_saleorder_document_employee_note" inherit_id="sale.report_saleorder_document">
        <xpath expr="//table[@name='sale_order_line_table']" position="before">
            <t t-set="salary_matrix"
               t-value="o._get_salary_matrix() if o.is_salaries and o.payslip_run_id else {'columns': [], 'rows': []}"/>
        </xpath>

        <xpath expr="//th[@name='th_subtotal']" position="after">
            <t t-if="o.is_salaries and o.payslip_run_id">
                <t t-foreach="salary_matrix['columns']" t-as="col">
                    <th class="text-end"><span t-esc="col['name']"/></th>
                </t>
                <th class="text-end"><span>Total Employee Cost</span></th>
            </t>
        </xpath>

        <xpath expr="//td[@name='td_subtotal']" position="after">
            <t t-if="o.is_salaries and o.payslip_run_id and line.employee_id">
                <t t-set="emp_row"
                   t-value="next((r for r in salary_matrix['rows'] if r['employee_id'] == line.employee_id.id), None)"/>
                <t t-if="emp_row">
                    <t t-foreach="emp_row['values']" t-as="val">
                        <td class="text-end"><span t-esc="'%.2f' % val"/></td>
                    </t>
                    <td class="text-end"><strong><span t-esc="'%.2f' % emp_row['employee_cost']"/></strong></td>
                </t>
                <t t-else="">
                    <t t-foreach="salary_matrix['columns']" t-as="col"><td/></t>
                    <td/>
                </t>
            </t>
            <t t-elif="o.is_salaries and o.payslip_run_id">
                <t t-foreach="salary_matrix['columns']" t-as="col"><td/></t>
                <td/>
            </t>
        </xpath>
    </template>
</odoo>
