<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_employee_view" model="ir.ui.view">
        <field name="name">purchase.order.form.employee</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id'] | //field[@name='order_line']//tree//field[@name='product_id']"
                   position="after">
                <field name="employee_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
