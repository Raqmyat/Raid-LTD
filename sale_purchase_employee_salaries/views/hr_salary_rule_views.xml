<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_salary_rule_form_profit_account" model="ir.ui.view">
        <field name="name">hr.salary.rule.form.profit.account</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="hr_payroll.hr_salary_rule_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="profit_account_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
