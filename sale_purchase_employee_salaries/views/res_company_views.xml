<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_form_salary_journal" model="ir.ui.view">
        <field name="name">res.company.form.salary.journal</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="salary_reclass_journal_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
