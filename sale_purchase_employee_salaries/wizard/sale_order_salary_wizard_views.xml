<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_salary_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.salary.wizard.form</field>
        <field name="model">sale.order.salary.wizard</field>
        <field name="arch" type="xml">
            <form string="توليد بنود المرتبات">
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="product_id" options="{'no_create': True}"/>
                    <field name="payslip_run_id" options="{'no_create': True}"/>
                    <field name="generation_mode"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="employee_id" readonly="1" force_save="1"/>
                        <field name="name" readonly="1" force_save="1" string="البند"/>
                        <field name="amount"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="to_include"/>
                    </list>
                </field>
                <footer>
                    <button name="action_generate_lines" type="object"
                            string="توليد البنود" class="btn-primary"
                            confirm="هيتضاف سطر لكل بند متعلّم بعلامة 'يتضاف؟'. متأكد؟"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_order_salary_wizard" model="ir.actions.act_window">
        <field name="name">توليد بنود المرتبات</field>
        <field name="res_model">sale.order.salary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
