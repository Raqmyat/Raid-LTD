<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- noupdate="1" يخلي القاعدتين يتحطوا مرة واحدة بس عند أول تنصيب.
         لو الأدمن عدّل فيهم أو مسحهم بعد كده، مش هيترجعوا تاني مع أي Update للموديول -->

    <record id="rule_hr_employee_name" model="translation.rule">
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="field_ids" eval="[(6, 0, [ref('hr.field_hr_employee__name')])]"/>
        <field name="translate_mode">transliteration</field>
        <field name="active">1</field>
        <field name="note">قاعدة افتراضية: ترجمة (نقحرة) اسم الموظف تلقائيًا.</field>
    </record>

    <record id="rule_product_template_name" model="translation.rule">
        <field name="model_id" ref="product.model_product_template"/>
        <field name="field_ids" eval="[(6, 0, [ref('product.field_product_template__name')])]"/>
        <field name="translate_mode">dictionary</field>
        <field name="active">1</field>
        <field name="note">قاعدة افتراضية: ترجمة اسم المنتج تلقائيًا حسب القاموس.</field>
    </record>

</odoo>
