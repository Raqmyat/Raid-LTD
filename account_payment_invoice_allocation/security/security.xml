<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Allocation lines are accessed exclusively through their parent payment
        (account.payment already enforces multi-company record rules), so a
        company-based record rule is added defensively for direct access/API use.
    -->
    <record id="account_payment_allocation_line_comp_rule" model="ir.rule">
        <field name="name">Payment Allocation Line: multi-company</field>
        <field name="model_id" ref="model_account_payment_allocation_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
</odoo>
