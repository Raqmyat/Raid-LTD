<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ form -->
    <record id="view_client_contract_form" model="ir.ui.view">
        <field name="name">crm.client.contract.form</field>
        <field name="model">crm.client.contract</field>
        <field name="arch" type="xml">
            <form string="Client Contract">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_open_renew_wizard" type="object" string="Renew" class="btn-primary"
                            invisible="state != 'running'"/>
                    <button name="action_terminate" type="object" string="Terminate"
                            invisible="state != 'running'"
                            confirm="Terminate this contract?"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'running')"/>
                    <button name="action_draft" type="object" string="Set to Draft"
                            invisible="state not in ('cancel', 'terminated')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,renewed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_chain" type="object" class="oe_stat_button" icon="fa-history"
                                invisible="not previous_contract_id and not renewed_contract_id">
                            <div class="o_stat_info"><span class="o_stat_text">Term History</span></div>
                        </button>
                    </div>
                    <div class="alert alert-warning text-center" role="alert"
                         invisible="expiry_status != 'expiring'">
                        <strong>This contract expires in <field name="days_left" class="oe_inline"/> day(s).</strong>
                        Renew it or contact the client.
                    </div>
                    <div class="alert alert-danger text-center" role="alert"
                         invisible="expiry_status != 'expired'">
                        <strong>This contract has EXPIRED and was not renewed.</strong>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Client">
                            <field name="active" invisible="1"/>
                            <field name="expiry_status" invisible="1"/>
                            <field name="partner_id" options="{'no_create_edit': True}"/>
                            <field name="opportunity_id" options="{'no_create': True}"/>
                            <field name="client_company_id" options="{'no_create': True}"/>
                            <field name="contract_type"/>
                            <field name="service_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group string="Term &amp; Follow-up">
                            <field name="date_signed"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="duration_days"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fees &amp; Scope" name="fees">
                            <group>
                                <group string="Fees">
                                    <field name="currency_id" groups="base.group_multi_currency"/>
                                    <field name="fee_type"/>
                                    <field name="fee_amount" invisible="fee_type == 'percent_payroll'"/>
                                    <field name="fee_percent" invisible="fee_type != 'percent_payroll'"/>
                                    <field name="monthly_value"/>
                                    <field name="payment_days"/>
                                </group>
                                <group string="Headcount &amp; Payroll">
                                    <field name="headcount"/>
                                    <field name="actual_headcount" invisible="not client_company_id"/>
                                    <field name="payroll_cycle"/>
                                    <field name="payroll_cutoff_day"/>
                                    <field name="payday"/>
                                </group>
                            </group>
                        </page>
                        <page string="Renewal &amp; Alerts" name="renewal">
                            <group>
                                <group string="Renewal">
                                    <field name="auto_renew"/>
                                    <field name="renewal_months" invisible="not auto_renew"/>
                                    <field name="termination_notice_days"/>
                                    <field name="previous_contract_id"/>
                                    <field name="renewed_contract_id"/>
                                </group>
                                <group string="Expiry Alerts">
                                    <field name="notice_days"/>
                                    <field name="notify_user_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Alerts go to the account manager, the users above and the followers:
                                when the end date is within the alert days, then at 30 / 15 / 7 days
                                and when the contract has expired.
                            </p>
                        </page>
                        <page string="Terms &amp; Notes" name="notes">
                            <field name="notes" placeholder="Special terms, SLA, penalties, client contacts..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ list -->
    <record id="view_client_contract_list" model="ir.ui.view">
        <field name="name">crm.client.contract.list</field>
        <field name="model">crm.client.contract</field>
        <field name="arch" type="xml">
            <list string="Client Contracts"
                  decoration-danger="expiry_status == 'expired'"
                  decoration-warning="expiry_status == 'expiring'"
                  decoration-muted="state in ('renewed', 'terminated', 'cancel')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="days_left" string="Days Left" invisible="state != 'running'"/>
                <field name="headcount" optional="show" sum="Employees"/>
                <field name="monthly_value" optional="show" sum="Monthly Fees"/>
                <field name="currency_id" optional="hide"/>
                <field name="auto_renew" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="expiry_status" widget="badge" optional="show"
                       decoration-success="expiry_status == 'ok'"
                       decoration-warning="expiry_status == 'expiring'"
                       decoration-danger="expiry_status == 'expired'"
                       decoration-muted="expiry_status == 'na'"/>
                <field name="state" widget="badge" optional="show"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'running'"
                       decoration-muted="state in ('renewed', 'terminated', 'cancel')"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ kanban -->
    <record id="view_client_contract_kanban" model="ir.ui.view">
        <field name="name">crm.client.contract.kanban</field>
        <field name="model">crm.client.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="expiry_status" create="1" group_create="0" group_delete="0" group_edit="0">
                <field name="state"/>
                <field name="partner_id"/>
                <field name="name"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <strong t-out="record.partner_id.value"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </div>
                        <div class="text-muted" t-out="record.name.value"/>
                        <field name="contract_type"/>
                        <div class="mt-1">
                            <field name="date_start"/> → <field name="date_end"/>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span t-if="record.state.raw_value == 'running'">
                                <field name="days_left"/> day(s) left
                            </span>
                            <span t-else="" t-out="record.state.value"/>
                            <field name="monthly_value" widget="monetary"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ search -->
    <record id="view_client_contract_search" model="ir.ui.view">
        <field name="name">crm.client.contract.search</field>
        <field name="model">crm.client.contract</field>
        <field name="arch" type="xml">
            <search string="Client Contracts">
                <field name="name" string="Contract / Client" filter_domain="['|', ('name', 'ilike', self), ('partner_id', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="contract_type"/>
                <field name="client_company_id"/>
                <filter name="my" string="My Contracts" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="running" string="Running" domain="[('state', '=', 'running')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="closed" string="Renewed / Terminated / Cancelled"
                        domain="[('state', 'in', ('renewed', 'terminated', 'cancel'))]"/>
                <separator/>
                <filter name="expiring" string="Expiring Soon (alert window)"
                        domain="[('expiry_status', '=', 'expiring')]"/>
                <filter name="expired" string="Expired (not renewed)" domain="[('expiry_status', '=', 'expired')]"/>
                <filter name="end_30" string="Ends within 30 days"
                        domain="[('state', '=', 'running'), ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_end', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="end_60" string="Ends within 60 days"
                        domain="[('state', '=', 'running'), ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_end', '&lt;=', (context_today() + relativedelta(days=60)).strftime('%Y-%m-%d'))]"/>
                <filter name="end_90" string="Ends within 90 days"
                        domain="[('state', '=', 'running'), ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_end', '&lt;=', (context_today() + relativedelta(days=90)).strftime('%Y-%m-%d'))]"/>
                <filter name="auto_renew" string="Auto-Renew" domain="[('auto_renew', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_client" string="Client" context="{'group_by': 'partner_id'}"/>
                <filter name="group_type" string="Contract Type" context="{'group_by': 'contract_type'}"/>
                <filter name="group_manager" string="Account Manager" context="{'group_by': 'user_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_expiry" string="Expiry Status" context="{'group_by': 'expiry_status'}"/>
                <filter name="group_end_month" string="End Month" context="{'group_by': 'date_end:month'}"/>
            </search>
        </field>
    </record>

    <!-- ============================================================ pivot / graph -->
    <record id="view_client_contract_pivot" model="ir.ui.view">
        <field name="name">crm.client.contract.pivot</field>
        <field name="model">crm.client.contract</field>
        <field name="arch" type="xml">
            <pivot string="Client Contracts">
                <field name="contract_type" type="row"/>
                <field name="expiry_status" type="col"/>
                <field name="monthly_value" type="measure"/>
                <field name="headcount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_client_contract_graph" model="ir.ui.view">
        <field name="name">crm.client.contract.graph</field>
        <field name="model">crm.client.contract</field>
        <field name="arch" type="xml">
            <graph string="Contracts ending per month" type="bar">
                <field name="date_end" interval="month"/>
                <field name="expiry_status"/>
            </graph>
        </field>
    </record>

    <!-- ============================================================ actions -->
    <record id="action_client_contract" model="ir.actions.act_window">
        <field name="name">Client Contracts</field>
        <field name="res_model">crm.client.contract</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="search_view_id" ref="view_client_contract_search"/>
        <field name="context">{'search_default_running': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first client contract</p>
            <p>Record the service contracts signed with clients (payroll, HR administration...)
               with their start / end dates. The system alerts you before they expire.</p>
        </field>
    </record>

    <record id="action_client_contract_expiring" model="ir.actions.act_window">
        <field name="name">Contracts to Renew</field>
        <field name="res_model">crm.client.contract</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_client_contract_search"/>
        <field name="domain">[('expiry_status', 'in', ('expiring', 'expired'))]</field>
    </record>

    <record id="action_client_contract_service" model="ir.actions.act_window">
        <field name="name">Contract Services</field>
        <field name="res_model">crm.client.contract.service</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_client_contract_service_list" model="ir.ui.view">
        <field name="name">crm.client.contract.service.list</field>
        <field name="model">crm.client.contract.service</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
</odoo>
