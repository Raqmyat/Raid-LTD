<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_client_contract" model="res.groups.privilege">
        <field name="name">Client Contracts</field>
        <field name="sequence">55</field>
        <field name="category_id" ref="base.module_category_sales_crm"/>
    </record>
    <!-- read only: can be given to anybody who must follow the alerts -->
    <record id="group_client_contract_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_client_contract"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_client_contract_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_client_contract"/>
        <field name="implied_ids" eval="[(4, ref('group_client_contract_viewer'))]"/>
    </record>
    <record id="group_client_contract_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_client_contract"/>
        <field name="implied_ids" eval="[(4, ref('group_client_contract_user'))]"/>
    </record>

    <!-- CRM salesmen work with the contracts, CRM managers / HR managers manage / follow them -->
    <record id="sales_team.group_sale_salesman" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_client_contract_user'))]"/>
    </record>
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_client_contract_manager'))]"/>
    </record>
    <record id="hr.group_hr_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_client_contract_viewer'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_client_contract_company" model="ir.rule">
            <field name="name">Client Contract: multi-company</field>
            <field name="model_id" ref="model_crm_client_contract"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
