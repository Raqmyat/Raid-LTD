<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_client_contract_renew_wizard_form" model="ir.ui.view">
        <field name="name">crm.client.contract.renew.wizard.form</field>
        <field name="model">crm.client.contract.renew.wizard</field>
        <field name="arch" type="xml">
            <form string="Renew Contract">
                <group>
                    <group>
                        <field name="contract_id"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="fee_amount"/>
                        <field name="headcount"/>
                    </group>
                </group>
                <p class="text-muted">
                    A new contract (next term) is created and running; the current one becomes "Renewed".
                </p>
                <footer>
                    <button name="action_renew" type="object" string="Renew" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
