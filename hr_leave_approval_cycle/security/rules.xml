<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Read-only visibility, so the cycle's approvers can see the requests they
         have to process without receiving the standard Time Off access groups. -->
    <record id="rule_leave_appr_manager_read" model="ir.rule">
        <field name="name">Time Off cycle: direct manager reads team requests</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">['|', ('employee_id.parent_id.user_id', '=', user.id), ('employee_id.leave_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_leave_appr_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_leave_appr_all_read" model="ir.rule">
        <field name="name">Time Off cycle: HR / CFO / CEO read all requests</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_leave_appr_hr')), (4, ref('group_leave_appr_cfo')), (4, ref('group_leave_appr_ceo'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
