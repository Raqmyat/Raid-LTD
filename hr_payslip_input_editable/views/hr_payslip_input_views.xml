<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Editable List View -->
    <record id="view_hr_payslip_input_editable_list" model="ir.ui.view">
        <field name="name">hr.payslip.input.editable.list</field>
        <field name="model">hr.payslip.input</field>
        <field name="arch" type="xml">
            <list string="Salary Inputs" editable="bottom" default_order="employee_id">
                <field name="employee_id" readonly="1"/>
                <field name="department_id" readonly="1" optional="show"/>
                <field name="date_from" readonly="1" optional="hide"/>
                <field name="date_to" readonly="1" optional="hide"/>
                <field name="payslip_id" readonly="1"/>
                <field name="payslip_state" readonly="1" optional="show"/>
                <field name="input_type_id"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hr_payslip_input_editable_search" model="ir.ui.view">
        <field name="name">hr.payslip.input.editable.search</field>
        <field name="model">hr.payslip.input</field>
        <field name="arch" type="xml">
            <search string="Salary Inputs">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="input_type_id"/>
                <field name="payslip_id"/>
                <filter string="Actual Basic" name="filter_actual_basic"
                        domain="[('input_type_id.code', '=', 'ACTUALBASIC')]"/>
                <filter string="Draft Payslips" name="filter_draft"
                        domain="[('payslip_state', '=', 'draft')]"/>
                <separator/>
                <filter string="This Month" name="filter_this_month"
                        domain="[('date_from', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="groupby_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="groupby_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Input Type" name="groupby_input_type" context="{'group_by': 'input_type_id'}"/>
                    <filter string="Payslip" name="groupby_payslip" context="{'group_by': 'payslip_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_hr_payslip_input_editable" model="ir.actions.act_window">
        <field name="name">Salary Inputs</field>
        <field name="res_model">hr.payslip.input</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_hr_payslip_input_editable_list"/>
        <field name="search_view_id" ref="view_hr_payslip_input_editable_search"/>
        <field name="context">{'search_default_filter_actual_basic': 1, 'search_default_filter_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No salary input lines found.
            </p>
            <p>
                Salary input lines (e.g. Actual Basic) are usually added from each payslip's
                "Other Inputs" tab. Once payslips are generated for the period, they will appear
                here for quick bulk editing.
            </p>
        </field>
    </record>

    <!-- Menu Item under Payroll -->
    <menuitem id="menu_hr_payslip_input_editable"
              name="Salary Inputs (Bulk Edit)"
              action="action_hr_payslip_input_editable"
              parent="hr_payroll.menu_hr_payroll_root"
              sequence="30"/>

</odoo>
