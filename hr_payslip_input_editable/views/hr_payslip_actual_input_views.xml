<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Editable List View -->
    <record id="view_hr_payslip_actual_input_list" model="ir.ui.view">
        <field name="name">hr.payslip.actual.input.list</field>
        <field name="model">hr.payslip.actual.input</field>
        <field name="arch" type="xml">
            <list string="Actual Salary Inputs" editable="bottom" default_order="date_from desc, employee_id">
                <field name="employee_id"/>
                <field name="department_id" readonly="1" optional="show"/>
                <field name="input_type_id"/>
                <field name="date_from"/>
                <field name="amount"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_hr_payslip_actual_input" model="ir.actions.act_window">
        <field name="name">Actual Salary Inputs</field>
        <field name="res_model">hr.payslip.actual.input</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_hr_payslip_actual_input_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No actual salary input entries yet.
            </p>
            <p>
                Add one row per employee: pick the employee, the input type
                (e.g. Actual Basic), the month, and the amount. Salary rules
                will read this value directly when the payslip is computed.
            </p>
        </field>
    </record>

    <!-- Standalone top-level Menu -->
    <menuitem id="menu_hr_payslip_actual_input_root"
              name="Actual Salary Inputs"
              sequence="90"/>

    <menuitem id="menu_hr_payslip_actual_input"
              name="Actual Salary Inputs"
              action="action_hr_payslip_actual_input"
              parent="menu_hr_payslip_actual_input_root"
              sequence="10"/>

</odoo>
