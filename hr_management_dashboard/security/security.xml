<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Normal access right: Settings > Users > (user) > Human Resources > "HR Reports".
         Enabling it also enables everything needed to open the module. -->
    <record id="privilege_hr_reports" model="res.groups.privilege">
        <field name="name">HR Reports</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>
    <record id="group_hr_reports_user" model="res.groups">
        <field name="name">HR Reports User</field>
        <field name="privilege_id" ref="privilege_hr_reports"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('hr.group_hr_user')),
            (4, ref('hr_payroll.group_hr_payroll_user')),
            (4, ref('hr_holidays.group_hr_holidays_user')),
            (4, ref('crm_client_contract.group_client_contract_viewer')),
        ]"/>
    </record>
    <!-- HR managers keep working exactly as before -->
    <record id="hr.group_hr_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_hr_reports_user'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_hr_audit_log_company" model="ir.rule">
            <field name="name">HR Audit Log: multi-company</field>
            <field name="model_id" ref="model_hr_audit_log"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_hr_employee_data_issue_company" model="ir.rule">
            <field name="name">HR Employee Data Issue: multi-company</field>
            <field name="model_id" ref="model_hr_employee_data_issue"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_hr_payslip_billing_status_company" model="ir.rule">
            <field name="name">HR Payslip Billing Status: multi-company</field>
            <field name="model_id" ref="model_hr_payslip_billing_status"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_hr_skill_report_company" model="ir.rule">
            <field name="name">HR Skill Report: multi-company</field>
            <field name="model_id" ref="model_hr_skill_report"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
