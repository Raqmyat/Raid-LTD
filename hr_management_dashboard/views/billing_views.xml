<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payslip_billing_list" model="ir.ui.view">
        <field name="name">hr.payslip.billing.status.list</field>
        <field name="model">hr.payslip.billing.status</field>
        <field name="arch" type="xml">
            <list string="Payslip Billing Status" action="action_open_payslip" type="object"
                  create="0" edit="0" delete="0">
                <field name="company_id" optional="show"/>
                <field name="payslip_run_id"/>
                <field name="department_id" optional="hide"/>
                <field name="employee_id"/>
                <field name="date_from" optional="hide"/>
                <field name="date_to" optional="hide"/>
                <field name="billable_amount" sum="Total"/>
                <field name="billing_status" widget="badge"
                       decoration-danger="billing_status == 'none'"
                       decoration-warning="billing_status == 'ordered'"
                       decoration-success="billing_status == 'invoiced'"/>
                <field name="sale_order_id"/>
                <field name="invoice_id"/>
                <field name="invoice_payment_state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_payslip_billing_pivot" model="ir.ui.view">
        <field name="name">hr.payslip.billing.status.pivot</field>
        <field name="model">hr.payslip.billing.status</field>
        <field name="arch" type="xml">
            <pivot string="Payslip Billing Status">
                <field name="payslip_run_id" type="row"/>
                <field name="billing_status" type="col"/>
                <field name="billable_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_payslip_billing_search" model="ir.ui.view">
        <field name="name">hr.payslip.billing.status.search</field>
        <field name="model">hr.payslip.billing.status</field>
        <field name="arch" type="xml">
            <search string="Payslip Billing Status">
                <field name="employee_id"/>
                <field name="payslip_run_id"/>
                <field name="company_id"/>
                <field name="sale_order_id"/>
                <field name="invoice_id"/>
                <filter name="st_none" string="No Sale Order" domain="[('billing_status', '=', 'none')]"/>
                <filter name="st_ordered" string="Sale Order - Not Invoiced" domain="[('billing_status', '=', 'ordered')]"/>
                <filter name="st_invoiced" string="Invoiced" domain="[('billing_status', '=', 'invoiced')]"/>
                <separator/>
                <filter name="group_run" string="Pay Run" context="{'group_by': 'payslip_run_id'}"/>
                <filter name="group_status" string="Billing Status" context="{'group_by': 'billing_status'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_payslip_billing_status" model="ir.actions.act_window">
        <field name="name">Payslip Billing Status</field>
        <field name="res_model">hr.payslip.billing.status</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_payslip_billing_search"/>
        <field name="context">{'search_default_group_run': 1, 'search_default_group_status': 1}</field>
    </record>
    <record id="action_payslip_billing_status_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_payslip_billing_list"/>
        <field name="act_window_id" ref="action_payslip_billing_status"/>
    </record>
    <record id="action_payslip_billing_status_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_payslip_billing_pivot"/>
        <field name="act_window_id" ref="action_payslip_billing_status"/>
    </record>
    <!-- client action: rebuilds the snapshot first (via JS), then opens the report -->
    <record id="action_payslip_billing_client" model="ir.actions.client">
        <field name="name">Payslip Billing Status</field>
        <field name="tag">hr_management_dashboard.open_billing_status</field>
    </record>
</odoo>
