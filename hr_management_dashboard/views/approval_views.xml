<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Where is each payroll batch in the approval cycle -->
    <record id="view_payroll_approval_list" model="ir.ui.view">
        <field name="name">hr.payslip.run.approval.status.list</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <list string="Payroll Approval Status" create="0" delete="0"
                  default_order="date_start desc, id desc"
                  decoration-success="state in ('ceo', 'close', 'paid')"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="company_id" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="rpt_slip_count" string="Payslips"/>
                <field name="state" widget="badge"/>
                <field name="approval_waiting_for"/>
                <field name="write_date" string="Last Updated" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_payroll_approval_search" model="ir.ui.view">
        <field name="name">hr.payslip.run.approval.status.search</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <search string="Payroll Approval Status">
                <field name="name"/>
                <field name="company_id"/>
                <filter name="not_submitted" string="Not Submitted" domain="[('state', '=', 'draft')]"/>
                <filter name="in_approval" string="In Approval"
                        domain="[('state', 'in', ['submitted', 'op_manager', 'hr', 'legal', 'finance', 'audit'])]"/>
                <filter name="fully_approved" string="Fully Approved (CEO)" domain="[('state', '=', 'ceo')]"/>
                <filter name="period" string="Period" date="date_start"/>
                <separator/>
                <filter name="group_state" string="Approval Stage" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                <filter name="group_month" string="Month" context="{'group_by': 'date_start:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_payroll_approval_status" model="ir.actions.act_window">
        <field name="name">Payroll Approval Status</field>
        <field name="res_model">hr.payslip.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_payroll_approval_search"/>
    </record>
    <record id="action_payroll_approval_status_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_payroll_approval_list"/>
        <field name="act_window_id" ref="action_payroll_approval_status"/>
    </record>
</odoo>
