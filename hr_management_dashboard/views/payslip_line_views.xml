<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payslip_line_report_list" model="ir.ui.view">
        <field name="name">hr.payslip.line.report.list</field>
        <field name="model">hr.payslip.line</field>
        <field name="arch" type="xml">
            <list string="Payroll Rules" action="action_open_payslip" type="object"
                  create="0" edit="0" delete="0" default_order="rpt_date_from desc, rpt_employee_id, sequence">
                <field name="rpt_company_id" optional="show"/>
                <field name="rpt_department_id" optional="show"/>
                <field name="rpt_employee_id"/>
                <field name="slip_id" optional="hide"/>
                <field name="rpt_date_from" string="From"/>
                <field name="rpt_date_to" string="To" optional="show"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id" optional="show"/>
                <field name="quantity" optional="hide"/>
                <field name="rate" optional="hide"/>
                <field name="amount" optional="hide"/>
                <field name="total" sum="Total"/>
                <field name="rpt_state" string="Payslip Status" widget="badge" optional="show"
                       decoration-muted="rpt_state == 'draft'"
                       decoration-info="rpt_state in ('submitted', 'ops_approved', 'hr_approved')"
                       decoration-warning="rpt_state in ('finance', 'ceo')"
                       decoration-success="rpt_state == 'validated'"
                       decoration-primary="rpt_state == 'paid'"
                       decoration-danger="rpt_state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_payslip_line_report_pivot" model="ir.ui.view">
        <field name="name">hr.payslip.line.report.pivot</field>
        <field name="model">hr.payslip.line</field>
        <field name="arch" type="xml">
            <pivot string="Payroll Rules">
                <field name="rpt_company_id" type="row"/>
                <field name="rpt_department_id" type="row"/>
                <field name="rpt_employee_id" type="row"/>
                <field name="code" type="col"/>
                <field name="total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_payslip_line_report_search" model="ir.ui.view">
        <field name="name">hr.payslip.line.report.search</field>
        <field name="model">hr.payslip.line</field>
        <field name="arch" type="xml">
            <search string="Payroll Rules">
                <field name="rpt_employee_id"/>
                <field name="rpt_department_id"/>
                <field name="rpt_company_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="slip_id"/>
                <filter name="period" string="Period" date="rpt_date_from"/>
                <separator/>
                <filter name="st_draft" string="Draft (not submitted)" domain="[('rpt_state', '=', 'draft')]"/>
                <filter name="st_approval" string="In Approval (Submitted → CEO)"
                        domain="[('rpt_state', 'in', ['submitted', 'ops_approved', 'hr_approved', 'finance', 'ceo'])]"/>
                <filter name="st_closed" string="Validated / Paid" domain="[('rpt_state', 'in', ['validated', 'paid'])]"/>
                <filter name="st_validated" string="Validated (not paid)" domain="[('rpt_state', '=', 'validated')]"/>
                <filter name="st_paid" string="Paid" domain="[('rpt_state', '=', 'paid')]"/>
                <filter name="st_cancel" string="Cancelled / Refused" domain="[('rpt_state', '=', 'cancel')]"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'rpt_company_id'}"/>
                <filter name="group_department" string="Department" context="{'group_by': 'rpt_department_id'}"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'rpt_employee_id'}"/>
                <filter name="group_slip" string="Payslip" context="{'group_by': 'slip_id'}"/>
                <filter name="group_state" string="Payslip Status" context="{'group_by': 'rpt_state'}"/>
                <filter name="group_rule" string="Rule" context="{'group_by': 'code'}"/>
                <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                <filter name="group_month" string="Month" context="{'group_by': 'rpt_date_from:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_payslip_line_report" model="ir.actions.act_window">
        <field name="name">Payroll Rules Report</field>
        <field name="res_model">hr.payslip.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_payslip_line_report_search"/>
        <field name="context">{'search_default_group_company': 1, 'search_default_group_department': 1, 'search_default_group_employee': 1}</field>
    </record>
    <record id="action_payslip_line_report_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_payslip_line_report_list"/>
        <field name="act_window_id" ref="action_payslip_line_report"/>
    </record>
    <record id="action_payslip_line_report_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_payslip_line_report_pivot"/>
        <field name="act_window_id" ref="action_payslip_line_report"/>
    </record>
</odoo>
