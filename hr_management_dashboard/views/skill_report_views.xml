<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_skill_report_list" model="ir.ui.view">
        <field name="name">hr.employee.skill.report.list</field>
        <field name="model">hr.employee.skill.report</field>
        <field name="arch" type="xml">
            <list string="Skills &amp; Certifications" action="action_open_employee" type="object"
                  create="0" edit="0" delete="0"
                  decoration-danger="expiry_status == 'expired'"
                  decoration-warning="expiry_status in ('expiring', 'no_expiry')">
                <field name="company_id" optional="hide"/>
                <field name="department_id" optional="show"/>
                <field name="employee_id"/>
                <field name="skill_type_id"/>
                <field name="skill_id"/>
                <field name="skill_level_id"/>
                <field name="level_progress" widget="progressbar" optional="hide"/>
                <field name="is_certification" widget="boolean"/>
                <field name="valid_from" optional="show"/>
                <field name="valid_to"/>
                <field name="days_left" invisible="not valid_to"/>
                <field name="expiry_status" widget="badge"
                       decoration-danger="expiry_status == 'expired'"
                       decoration-warning="expiry_status in ('expiring', 'no_expiry')"
                       decoration-success="expiry_status == 'valid'"
                       decoration-muted="expiry_status == 'no_certificate'"/>
            </list>
        </field>
    </record>

    <record id="view_employee_skill_report_search" model="ir.ui.view">
        <field name="name">hr.employee.skill.report.search</field>
        <field name="model">hr.employee.skill.report</field>
        <field name="arch" type="xml">
            <search string="Skills &amp; Certifications">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="skill_type_id"/>
                <field name="skill_id"/>
                <filter name="cert_yes" string="Certifications" domain="[('is_certification', '=', True)]"/>
                <filter name="cert_no" string="Not Certifications" domain="[('is_certification', '=', False)]"/>
                <separator/>
                <filter name="st_expired" string="Expired" domain="[('expiry_status', '=', 'expired')]"/>
                <filter name="st_expiring" string="Expiring within 60 days" domain="[('expiry_status', '=', 'expiring')]"/>
                <filter name="st_no_expiry" string="Certification without expiry date" domain="[('expiry_status', '=', 'no_expiry')]"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_type" string="Skill Type" context="{'group_by': 'skill_type_id'}"/>
                <filter name="group_status" string="Certificate Status" context="{'group_by': 'expiry_status'}"/>
            </search>
        </field>
    </record>

    <record id="action_employee_skill_report" model="ir.actions.act_window">
        <field name="name">Skills &amp; Certifications</field>
        <field name="res_model">hr.employee.skill.report</field>
        <field name="view_mode">list</field>
    </record>

    <!-- server action: rebuilds the rows first, then opens the list -->
    <record id="action_employee_skill_report_server" model="ir.actions.server">
        <field name="name">Skills &amp; Certifications</field>
        <field name="model_id" ref="model_hr_employee_skill_report"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_report()</field>
    </record>
</odoo>
