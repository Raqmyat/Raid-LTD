<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_audit_log_list" model="ir.ui.view">
        <field name="name">hr.audit.log.list</field>
        <field name="model">hr.audit.log</field>
        <field name="arch" type="xml">
            <list string="User Actions" action="action_open_record" type="object" create="0" edit="0" delete="0">
                <field name="log_date"/>
                <field name="user_id"/>
                <field name="action" widget="badge"
                       decoration-success="action == 'create'" decoration-info="action == 'write'"
                       decoration-danger="action == 'unlink'"/>
                <field name="model_label"/>
                <field name="record_name"/>
                <field name="details"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hr_audit_log_form" model="ir.ui.view">
        <field name="name">hr.audit.log.form</field>
        <field name="model">hr.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="log_date"/>
                            <field name="user_id"/>
                            <field name="action"/>
                        </group>
                        <group>
                            <field name="model_label"/>
                            <field name="record_name"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="What Changed"><field name="details" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_audit_log_pivot" model="ir.ui.view">
        <field name="name">hr.audit.log.pivot</field>
        <field name="model">hr.audit.log</field>
        <field name="arch" type="xml">
            <pivot string="User Actions">
                <field name="user_id" type="row"/>
                <field name="model_label" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_hr_audit_log_search" model="ir.ui.view">
        <field name="name">hr.audit.log.search</field>
        <field name="model">hr.audit.log</field>
        <field name="arch" type="xml">
            <search string="User Actions">
                <field name="user_id"/>
                <field name="record_name"/>
                <field name="details"/>
                <field name="model_label"/>
                <filter name="f_create" string="Created" domain="[('action', '=', 'create')]"/>
                <filter name="f_write" string="Updated" domain="[('action', '=', 'write')]"/>
                <filter name="f_unlink" string="Deleted" domain="[('action', '=', 'unlink')]"/>
                <separator/>
                <filter name="f_date" string="Date" date="log_day"/>
                <group string="Group By">
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_model" string="Module" context="{'group_by': 'model_label'}"/>
                    <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'log_day:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_audit_log" model="ir.actions.act_window">
        <field name="name">All User Actions</field>
        <field name="res_model">hr.audit.log</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="context">{'search_default_group_user': 1, 'create': False}</field>
    </record>

    <!-- wizard: choose period / users -->
    <record id="view_hr_audit_report_wizard_form" model="ir.ui.view">
        <field name="name">hr.audit.report.wizard.form</field>
        <field name="model">hr.audit.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Weekly Tasks Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="res_model"/>
                        <field name="action_type"/>
                    </group>
                </group>
                <group><field name="user_ids" widget="many2many_tags"/></group>
                <footer>
                    <button name="action_open_report" type="object" string="Show Report" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_audit_report_wizard" model="ir.actions.act_window">
        <field name="name">Weekly Tasks Report</field>
        <field name="res_model">hr.audit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
