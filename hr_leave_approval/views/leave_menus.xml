<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Time Off > Approval Cycle -->
    <menuitem id="menu_leave_approval_cycle" name="Approval Cycle"
              parent="hr_holidays.menu_hr_holidays_root" sequence="35"
              groups="hr_leave_approval.group_leave_manager,base.group_system"/>

    <!-- every request waiting for me (list buttons work on a selection: tick the header box once) -->
    <record id="action_leave_waiting_me" model="ir.actions.act_window">
        <field name="name">Waiting for my approval</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_lv_my_turn': 1}</field>
    </record>
    <menuitem id="menu_leave_waiting_me" name="Waiting for my approval"
              parent="menu_leave_approval_cycle" action="action_leave_waiting_me" sequence="5"/>

    <!-- one entry per button: opens the wizard with everything waiting for you, no selection -->

    <record id="server_action_leave_manager_approve" model="ir.actions.server">
        <field name="name">Time Off: Approve</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="state">code</field>
        <field name="code">action = env['hr.leave']._lv_menu_action('manager_approve')</field>
    </record>
    <menuitem id="menu_leave_manager_approve" name="Approve" parent="menu_leave_approval_cycle"
              action="server_action_leave_manager_approve" sequence="10"/>

    <record id="server_action_leave_close" model="ir.actions.server">
        <field name="name">Time Off: Approve &amp; Close</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="state">code</field>
        <field name="code">action = env['hr.leave']._lv_menu_action('close')</field>
    </record>
    <menuitem id="menu_leave_close" name="Approve &amp; Close" parent="menu_leave_approval_cycle"
              action="server_action_leave_close" sequence="20"/>

    <record id="server_action_leave_send_cfo" model="ir.actions.server">
        <field name="name">Time Off: Send to CFO</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="state">code</field>
        <field name="code">action = env['hr.leave']._lv_menu_action('send_cfo')</field>
    </record>
    <menuitem id="menu_leave_send_cfo" name="Send to CFO" parent="menu_leave_approval_cycle"
              action="server_action_leave_send_cfo" sequence="30"/>

    <record id="server_action_leave_send_ceo" model="ir.actions.server">
        <field name="name">Time Off: Send to CEO</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="state">code</field>
        <field name="code">action = env['hr.leave']._lv_menu_action('send_ceo')</field>
    </record>
    <menuitem id="menu_leave_send_ceo" name="Send to CEO" parent="menu_leave_approval_cycle"
              action="server_action_leave_send_ceo" sequence="40"/>

    <record id="server_action_leave_refuse" model="ir.actions.server">
        <field name="name">Time Off: Refuse</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="state">code</field>
        <field name="code">action = env['hr.leave']._lv_menu_action('refuse')</field>
    </record>
    <menuitem id="menu_leave_refuse" name="Refuse" parent="menu_leave_approval_cycle"
              action="server_action_leave_refuse" sequence="50"/>
</odoo>
