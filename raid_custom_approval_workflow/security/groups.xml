        <field name="privilege_id" ref="privilege_sale_hr"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_sale_audit" model="res.groups">
        <field name="name">Sales: Audit Approval</field>
        <field name="privilege_id" ref="privilege_sale_audit"/>
