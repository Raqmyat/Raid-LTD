<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sales Approval Groups -->
    <record id="module_category_raid_sale_approvals" model="ir.module.category">
        <field name="name">Raid Sales Approvals</field>
        <field name="description">Category for Raid Sales Approval Roles</field>
        <field name="sequence">22</field>
        <field name="parent_id" ref="base.module_category_sales"/>
    </record>

    <!-- Individual Privileges for Sales -->
    <record id="privilege_sale_ops_employee" model="res.groups.privilege">
        <field name="name">Sales: Operations Employee</field>
        <field name="category_id" ref="module_category_raid_sale_approvals"/>
    </record>

    <record id="privilege_sale_ops_manager" model="res.groups.privilege">
        <field name="name">Sales: Operations Manager</field>
        <field name="category_id" ref="module_category_raid_sale_approvals"/>
    </record>

    <record id="privilege_sale_hr" model="res.groups.privilege">
        <field name="name">Sales: HR Approval</field>
        <field name="category_id" ref="module_category_raid_sale_approvals"/>
    </record>

    <record id="privilege_sale_audit" model="res.groups.privilege">
        <field name="name">Sales: Audit Approval</field>
        <field name="category_id" ref="module_category_raid_sale_approvals"/>
    </record>

    <record id="privilege_sale_ceo" model="res.groups.privilege">
        <field name="name">Sales: CEO Approval</field>
        <field name="category_id" ref="module_category_raid_sale_approvals"/>
    </record>

    <!-- Updated Groups with Individual Privileges -->
    <record id="group_sale_ops_employee" model="res.groups">
        <field name="name">Sales: Operations Employee</field>
        <field name="privilege_id" ref="privilege_sale_ops_employee"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_sale_ops_manager" model="res.groups">
        <field name="name">Sales: Operations Manager</field>
        <field name="privilege_id" ref="privilege_sale_ops_manager"/>
