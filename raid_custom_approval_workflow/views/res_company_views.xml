<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_raid_approval" model="ir.ui.view">
        <field name="name">res.company.form.inherit.raid.approval</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Raid Approval Cycles" name="raid_approval_cycles">
                    <group string="Sales">
                        <field name="sale_approval_cycle_type" widget="radio"/>
                    </group>
                    <group string="Purchases">
                        <field name="purchase_approval_cycle_type" widget="radio"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
