<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_raid_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.raid.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Add Linked SO field -->
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="raid_linked_so_id" readonly="state != 'draft'"/>
            </xpath>

            <!-- Load hidden fields needed for conditions -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="use_purchase_approval_cycle" invisible="1"/>
            </xpath>

            <!-- Status bar: show approval states ONLY when approval cycle is enabled -->
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,sent,purchase</attribute>
            </xpath>

            <!-- When approval is enabled, show full approval path -->
            <xpath expr="//field[@name='state']" position="after">
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,sent,submitted,to_hr,to_finance,to_ceo_finance,finance_done,ceo_done_finance,to_legal,to_audit,to_cfo,to_ceo_cfo,cfo_done,ceo_done_cfo,purchase"
                       invisible="not use_purchase_approval_cycle"
                       readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='state'][1]" position="attributes">
                <attribute name="invisible">use_purchase_approval_cycle</attribute>
            </xpath>

            <!-- Approval Buttons in Header -->
            <xpath expr="//header" position="inside">
                <!-- Step 1: Ops Assistant submits -->
                <button name="action_submit_to_manager" string="Submit" type="object" class="btn-primary"
                        invisible="not use_purchase_approval_cycle or state != 'draft'"/>

                <!-- Step 2: Ops Manager approves -->
                <button name="action_op_manager_approve" string="Approve (Ops Manager)" type="object" class="btn-primary"
                        invisible="not use_purchase_approval_cycle or state != 'submitted'" groups="raid_custom_approval_workflow.group_purchase_ops_manager" />

                <!-- Step 3: HR Manager decision - exactly 2 options -->
                <button name="action_hr_send_to_finance" string="Send to Finance" type="object" class="btn-primary"
                        invisible="not use_purchase_approval_cycle or state != 'to_hr'" groups="raid_custom_approval_workflow.group_purchase_hr" />

                <button name="action_hr_send_to_legal" string="Send to Legal" type="object" class="btn-secondary"
                        invisible="not use_purchase_approval_cycle or state != 'to_hr'" groups="raid_custom_approval_workflow.group_purchase_hr" />

                <!-- Path A: Finance approves directly -> done, ready for payment
                     (or optionally escalate to CEO first) -->
                <button name="action_finance_approve" string="Approve &amp; Close (Finance)" type="object" class="btn-primary"
                        invisible="not use_purchase_approval_cycle or state != 'to_finance'" groups="raid_custom_approval_workflow.group_purchase_finance" />

                <button name="action_finance_send_to_ceo" string="Send to CEO" type="object" class="btn-secondary"
                        invisible="not use_purchase_approval_cycle or state != 'to_finance'" groups="raid_custom_approval_workflow.group_purchase_finance" />

                <button name="action_ceo_approve_from_finance" string="Approve (CEO)" type="object" class="btn-primary"
                        invisible="not use_purchase_approval_cycle or state != 'to_ceo_finance'" groups="raid_custom_approval_workflow.group_purchase_ceo" />

                <!-- Path B: Legal -> back to HR -> Audit -> CFO -->
                <button name="action_legal_approve" string="Approve (Legal)" type="object" class="btn-primary"
                        invisible="not use_purchase_approval_cycle or state != 'to_legal'" groups="raid_custom_approval_workflow.group_purchase_legal" />

                <button name="action_audit_approve" string="Approve (Audit)" type="object" class="btn-primary"
                        invisible="not use_purchase_approval_cycle or state != 'to_audit'" groups="raid_custom_approval_workflow.group_purchase_audit" />

                <button name="action_cfo_approve" string="Approve &amp; Close (Finance)" type="object" class="btn-primary"
                        invisible="not use_purchase_approval_cycle or state != 'to_cfo'" groups="raid_custom_approval_workflow.group_purchase_finance" />

                <button name="action_cfo_send_to_ceo" string="Send to CEO" type="object" class="btn-secondary"
                        invisible="not use_purchase_approval_cycle or state != 'to_cfo'" groups="raid_custom_approval_workflow.group_purchase_finance" />

                <button name="action_ceo_approve_from_cfo" string="Approve (CEO)" type="object" class="btn-primary"
                        invisible="not use_purchase_approval_cycle or state != 'to_ceo_cfo'" groups="raid_custom_approval_workflow.group_purchase_ceo" />

                <!-- Reject Button -->
                <button name="action_reject" string="Reject" type="object" class="btn-secondary"
                        invisible="not use_purchase_approval_cycle or state not in ['submitted', 'to_hr', 'to_finance', 'to_ceo_finance', 'to_legal', 'to_audit', 'to_cfo', 'to_ceo_cfo']"
                        groups="raid_custom_approval_workflow.group_purchase_ops_manager,raid_custom_approval_workflow.group_purchase_hr,raid_custom_approval_workflow.group_purchase_legal,raid_custom_approval_workflow.group_purchase_finance,raid_custom_approval_workflow.group_purchase_audit,raid_custom_approval_workflow.group_purchase_ceo" />
            </xpath>

            <!-- Confirm button visibility -->
            <xpath expr="//header/button[@name='button_confirm'][1]" position="attributes">
                <attribute name="invisible">(use_purchase_approval_cycle and state not in ['finance_done', 'cfo_done', 'ceo_done_finance', 'ceo_done_cfo']) or (not use_purchase_approval_cycle and state != 'draft')</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_confirm'][2]" position="attributes">
                <attribute name="invisible">use_purchase_approval_cycle or (not use_purchase_approval_cycle and state != 'sent')</attribute>
            </xpath>

        </field>
    </record>
</odoo>
