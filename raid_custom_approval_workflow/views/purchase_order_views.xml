<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_raid_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.raid.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Add Linked SO field -->
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="raid_linked_so_id" readonly="state != 'draft'"/>
            </xpath>

            <!-- Load hidden fields needed for conditions -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="use_purchase_approval_cycle" invisible="1"/>
            </xpath>

            <!-- Status bar: show approval states ONLY when approval cycle is enabled -->
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,sent,purchase</attribute>
            </xpath>

            <!-- When approval is enabled, show full approval path -->
            <xpath expr="//field[@name='state']" position="after">
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,sent,submitted,op_manager,finance,audit,ceo,purchase"
                       invisible="not use_purchase_approval_cycle"
                       readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='state'][1]" position="attributes">
                <attribute name="invisible">use_purchase_approval_cycle</attribute>
            </xpath>

            <!-- Approval Buttons in Header -->
            <xpath expr="//header" position="inside">
                <!-- Submit Button -->
                <button name="action_submit_to_manager" string="Submit" type="object" class="btn-primary"
                        invisible="not use_purchase_approval_cycle or state != 'draft'"/>

                <!-- Approval Buttons -->
                <button name="action_op_manager_approve" string="Approve (Ops Manager)" type="object" class="btn-primary"
                        invisible="not use_purchase_approval_cycle or state != 'submitted'" groups="raid_custom_approval_workflow.group_purchase_ops_manager" />

                <button name="action_finance_approve" string="Approve (Finance)" type="object" class="btn-primary"
                        invisible="not use_purchase_approval_cycle or state != 'op_manager'" groups="raid_custom_approval_workflow.group_purchase_finance" />

                <button name="action_audit_approve" string="Approve (Audit)" type="object" class="btn-primary"
                        invisible="not use_purchase_approval_cycle or state != 'finance'" groups="raid_custom_approval_workflow.group_purchase_audit" />

                <button name="action_ceo_approve" string="Approve (CEO)" type="object" class="btn-primary"
                        invisible="not use_purchase_approval_cycle or state != 'audit'" groups="raid_custom_approval_workflow.group_purchase_ceo" />

                <!-- Reject Button -->
                <button name="action_reject" string="Reject" type="object" class="btn-secondary"
                        invisible="not use_purchase_approval_cycle or state not in ['submitted', 'op_manager', 'finance', 'audit']"
                        groups="raid_custom_approval_workflow.group_purchase_ops_manager,raid_custom_approval_workflow.group_purchase_finance,raid_custom_approval_workflow.group_purchase_audit,raid_custom_approval_workflow.group_purchase_ceo" />
            </xpath>

            <!-- Confirm button visibility -->
            <xpath expr="//header/button[@name='button_confirm'][1]" position="attributes">
                <attribute name="invisible">(use_purchase_approval_cycle and state != 'ceo') or (not use_purchase_approval_cycle and state != 'draft')</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_confirm'][2]" position="attributes">
                <attribute name="invisible">use_purchase_approval_cycle or (not use_purchase_approval_cycle and state != 'sent')</attribute>
            </xpath>

        </field>
    </record>
</odoo>
