<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.raid.approval</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Sales Settings -->
            <xpath expr="//form//app[@name='sale_management']" position="inside">
                <block title="Raid Sales Approvals" id="raid_sale_approval_setting">
                    <setting string="Sales Approval Cycle" help="Enable multi-level approval for Sales Orders.">
                        <field name="use_sale_approval_cycle"/>
                    </setting>
                </block>
            </xpath>
            <!-- Purchase Settings -->
            <xpath expr="//form//app[@name='purchase']" position="inside">
                <block title="Raid Purchase Approvals" id="raid_purchase_approval_setting">
                    <setting string="Purchase Approval Cycle" help="Enable multi-level approval for Purchase Orders.">
                        <field name="use_purchase_approval_cycle"/>
                    </setting>
                </block>
            </xpath>
            <!--
                Payroll Settings.
                Your instance has no app[@name='payroll'] settings screen
                (confirmed by the install error), so instead of guessing
                another app name, we attach this block right next to the
                Purchase Approvals block above (which we know exists because
                it's inside app[@name='purchase'], already installed
                successfully). It will simply show up on the
                Settings > Purchase page alongside the purchase cycle toggle.
                If you'd rather have it under a specific Payroll/HR settings
                page, tell me the exact app name (Settings > Technical >
                Views > search "res.config.settings" > find the <app> tag
                name for your payroll app) and I'll move it there.
            -->
            <xpath expr="//block[@id='raid_purchase_approval_setting']" position="after">
                <block title="Raid Payroll Approvals" id="raid_payroll_approval_setting">
                    <setting string="Payroll Approval Cycle" help="Enable multi-level approval for Payslips and Payslips Batches.">
                        <field name="use_payroll_approval_cycle"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
