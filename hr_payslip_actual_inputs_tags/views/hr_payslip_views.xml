<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Expose the real Other Inputs lines directly in the Payslips list,
         using a custom widget: click "+" to see available Input Types
         (filtered by this payslip's Structure) immediately, pick one, and
         enter the Amount right there. Writes straight into the standard
         hr.payslip.input records - no separate table, no popups. -->
    <record id="hr_payslip_tree_actual_inputs_view" model="ir.ui.view">
        <field name="name">hr.payslip.list.actual.inputs.tags</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="input_line_ids"
                       widget="actual_inputs_tags"
                       optional="show"
                       string="Actual Inputs">
                    <list>
                        <field name="input_type_id"/>
                        <field name="amount"/>
                    </list>
                </field>
            </field>
        </field>
    </record>

</odoo>
