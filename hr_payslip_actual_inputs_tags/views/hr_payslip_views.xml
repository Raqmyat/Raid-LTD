<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Small popup shown when adding a new tag from the list: pick the
         Input Type, set the Amount. Same two fields Odoo already uses on
         hr.payslip.input, no extra restrictions added here. -->
    <record id="view_hr_payslip_input_quick_form" model="ir.ui.view">
        <field name="name">hr.payslip.input.quick.form</field>
        <field name="model">hr.payslip.input</field>
        <field name="arch" type="xml">
            <form string="Salary Input">
                <group>
                    <field name="input_type_id"
                           domain="[('struct_ids', 'in', [context.get('payslip_struct_id')])]"/>
                    <field name="amount"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Expose the real Other Inputs lines directly in the Payslips list,
         as tags you can add inline. You can add as many Input Types as
         needed for the same payslip/employee. -->
    <record id="hr_payslip_tree_actual_inputs_view" model="ir.ui.view">
        <field name="name">hr.payslip.list.actual.inputs.tags</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="input_line_ids"
                       widget="many2many_tags"
                       optional="show"
                       string="Actual Inputs"
                       domain="[('payslip_id', '=', id)]"
                       context="{'form_view_ref': 'hr_payslip_actual_inputs_tags.view_hr_payslip_input_quick_form', 'default_payslip_id': id, 'payslip_struct_id': struct_id}"
                       options="{'no_quick_create': True, 'no_create_edit': False}"/>
            </field>
        </field>
    </record>

</odoo>
