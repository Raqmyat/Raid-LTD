<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_combo_domain" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.combo.domain</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="domain">['|', ('purchase_ok', '=', True), ('type', '=', 'combo')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
