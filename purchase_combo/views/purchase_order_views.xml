<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_combo" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.combo</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="domain">['|', ('purchase_ok', '=', True), ('type', '=', 'combo')]</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="before">
                <field name="combo_product_id" column_invisible="True"/>
                <field name="combo_item_id" column_invisible="True"/>
                <field name="linked_line_id" column_invisible="True"/>
                <field name="linked_virtual_id" column_invisible="True"/>
                <field name="virtual_id" column_invisible="True"/>
                <field name="is_combo_component" column_invisible="True"/>
            </xpath>

            <!-- Combo component rows are real purchase lines, like the component rows
                 generated by Odoo Sales. Keep the product visible and make the generated
                 component product/description non-editable. -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="attributes">
                <attribute name="readonly">state in ('purchase', 'to approve', 'cancel') or is_downpayment or combo_item_id</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='name']" position="attributes">
                <attribute name="readonly">combo_item_id</attribute>
            </xpath>
        </field>
    </record>
</odoo>
