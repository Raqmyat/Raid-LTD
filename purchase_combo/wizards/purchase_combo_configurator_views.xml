<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_combo_configurator_form" model="ir.ui.view">
        <field name="name">purchase.combo.configurator.form</field>
        <field name="model">purchase.combo.configurator</field>
        <field name="arch" type="xml">
            <form string="Add Combo Product">
                <field name="order_id" invisible="1"/>
                <p>
                    Select a Combo product below. All of its components will be
                    added automatically to this Purchase Order with their own
                    quantity and cost — no selection needed.
                </p>
                <group>
                    <field name="product_tmpl_id"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Add to Order" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
