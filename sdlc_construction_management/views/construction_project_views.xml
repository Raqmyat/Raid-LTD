<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_construction_project_list" model="ir.ui.view">
        <field name="name">construction.project.list</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <list string="Construction Projects">
                <field name="reference"/>
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_construction_project_form" model="ir.ui.view">
        <field name="name">construction.project.form</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <form string="Construction Project">
                <header>
                    <button name="action_start" string="Start Project" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_complete" string="Complete" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_short_close" string="Short Close" type="object"
                            invisible="state not in ('draft', 'in_progress')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state in ('draft', 'completed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sub_projects" type="object" class="oe_stat_button" icon="fa-sitemap">
                            <field name="sub_project_count" widget="statinfo" string="Sub Projects"/>
                        </button>
                        <button name="action_view_budgets" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="budget_count" widget="statinfo" string="Budgets"/>
                        </button>
                        <button name="action_view_phases" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="phase_count" widget="statinfo" string="Phases"/>
                        </button>
                        <button name="action_view_work_orders" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="work_order_count" widget="statinfo" string="Work Orders"/>
                        </button>
                        <button name="action_view_mreq" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="mreq_count" widget="statinfo" string="MREQ"/>
                        </button>
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                        <button name="action_view_expenses" type="object" class="oe_stat_button" icon="fa-credit-card">
                            <field name="expense_count" widget="statinfo" string="Expenses"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="reference" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="warehouse_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Address">
                            <group>
                                <group>
                                    <field name="street"/>
                                    <field name="street2"/>
                                    <field name="city"/>
                                    <field name="state_id"/>
                                </group>
                                <group>
                                    <field name="zip"/>
                                    <field name="country_id"/>
                                    <field name="longitude"/>
                                    <field name="latitude"/>
                                </group>
                            </group>
                        </page>
                        <page string="Contact">
                            <group>
                                <group>
                                    <field name="phone"/>
                                    <field name="mobile"/>
                                    <field name="email"/>
                                </group>
                            </group>
                        </page>
                        <page string="Sub Projects">
                            <field name="sub_project_ids">
                                <list>
                                    <field name="reference"/>
                                    <field name="name"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Images">
                            <field name="image_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="image" widget="image" options="{'size': [100, 100]}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Permits &amp; Approvals">
                            <field name="permit_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="permit_type"/>
                                    <field name="issue_date"/>
                                    <field name="expiry_date"/>
                                    <field name="issuing_authority"/>
                                    <field name="state" widget="badge"/>
                                    <field name="document"/>
                                    <field name="document_name" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_construction_project_search" model="ir.ui.view">
        <field name="name">construction.project.search</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <search string="Construction Projects">
                <field name="name"/>
                <field name="reference"/>
                <field name="city"/>
                <field name="country_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <separator/>
                <group>
                    <filter name="group_state" string="Status" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_country" string="Country" domain="[]" context="{'group_by': 'country_id'}"/>
                    <filter name="group_warehouse" string="Warehouse" domain="[]" context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_construction_project" model="ir.actions.act_window">
        <field name="name">Construction Projects</field>
        <field name="res_model">construction.project</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Construction Project
            </p>
        </field>
    </record>
</odoo>
