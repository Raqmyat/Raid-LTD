<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_approval_submitter" model="res.groups.privilege">
        <field name="name">Payroll Submitter</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>
    <record id="group_approval_submitter" model="res.groups">
        <field name="name">Payroll Submitter</field>
        <field name="privilege_id" ref="privilege_approval_submitter"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="privilege_approval_ops" model="res.groups.privilege">
        <field name="name">Operations Approval</field>
        <field name="sequence">70</field>
