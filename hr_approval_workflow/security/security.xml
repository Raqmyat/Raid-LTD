        <field name="privilege_id" ref="privilege_approval_ops"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="privilege_approval_hr" model="res.groups.privilege">
        <field name="name">HR Approval</field>
        <field name="sequence">80</field>
