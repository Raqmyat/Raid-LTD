<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Integrates into the STANDARD payslip list/search. The approval statuses are values of the
         standard `state` field, so nothing is added to the model: the list only gets a status
         column and the search view gets the filters (APPENDED, nothing existing is replaced). -->
    <record id="hr_payslip_list_approval_state" model="ir.ui.view">
        <field name="name">hr.payslip.list.approval.state</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="state" string="Approval Status" widget="badge" optional="show"
                       decoration-muted="state == 'draft'"
                       decoration-info="state in ('submitted', 'ops_approved', 'hr_approved')"
                       decoration-warning="state in ('finance', 'ceo')"
                       decoration-success="state == 'validated'"
                       decoration-primary="state == 'paid'"
                       decoration-danger="state == 'cancel'"/>
            </xpath>
        </field>
    </record>

    <record id="hr_payslip_search_approval_state" model="ir.ui.view">
        <field name="name">hr.payslip.search.approval.state</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_filter"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="approval_my_turn" string="Approval: My Turn" domain="[('approval_my_turn', '=', True)]"/>
                <filter name="approval_f_submitted" string="Approval: Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="approval_f_ops" string="Approval: Operations Approved" domain="[('state', '=', 'ops_approved')]"/>
                <filter name="approval_f_hr" string="Approval: HR Approved" domain="[('state', '=', 'hr_approved')]"/>
                <filter name="approval_f_finance" string="Approval: Finance" domain="[('state', '=', 'finance')]"/>
                <filter name="approval_f_ceo" string="Approval: CEO" domain="[('state', '=', 'ceo')]"/>
                <filter name="approval_group_by" string="Status (approval)" context="{'group_by': 'state'}"/>
            </xpath>
        </field>
    </record>

</odoo>
