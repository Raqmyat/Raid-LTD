<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Integrates into the STANDARD payslip list/search (the same views the other
         payroll customizations extend). Nothing existing is replaced or moved:
         the approval column is only APPENDED at the end of the list and the
         filters are only APPENDED inside the search view. -->
    <record id="hr_payslip_list_approval_state" model="ir.ui.view">
        <field name="name">hr.payslip.list.approval.state</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="approval_state" widget="badge" optional="show"
                       decoration-muted="approval_state == 'draft'"
                       decoration-info="approval_state in ('submitted', 'ops_approved', 'hr_approved')"
                       decoration-warning="approval_state in ('finance', 'ceo')"
                       decoration-success="approval_state == 'done'"
                       decoration-danger="approval_state == 'refused'"/>
            </xpath>
        </field>
    </record>

    <record id="hr_payslip_search_approval_state" model="ir.ui.view">
        <field name="name">hr.payslip.search.approval.state</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_filter"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <field name="approval_state"/>
                <filter name="approval_my_turn" string="Approval: My Turn" domain="[('approval_my_turn', '=', True)]"/>
                <filter name="approval_f_draft" string="Approval: Draft" domain="[('approval_state', '=', 'draft')]"/>
                <filter name="approval_f_submitted" string="Approval: Submitted" domain="[('approval_state', '=', 'submitted')]"/>
                <filter name="approval_f_ops" string="Approval: Operations Approved" domain="[('approval_state', '=', 'ops_approved')]"/>
                <filter name="approval_f_hr" string="Approval: HR Approved" domain="[('approval_state', '=', 'hr_approved')]"/>
                <filter name="approval_f_finance" string="Approval: Finance" domain="[('approval_state', '=', 'finance')]"/>
                <filter name="approval_f_ceo" string="Approval: CEO" domain="[('approval_state', '=', 'ceo')]"/>
                <filter name="approval_f_done" string="Approval: Done" domain="[('approval_state', '=', 'done')]"/>
                <filter name="approval_f_refused" string="Approval: Refused" domain="[('approval_state', '=', 'refused')]"/>
                <filter name="approval_group_by" string="Approval Status" context="{'group_by': 'approval_state'}"/>
            </xpath>
        </field>
    </record>

</odoo>
