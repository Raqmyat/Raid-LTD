<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_step_list" model="ir.ui.view">
        <field name="name">approval.step.list</field>
        <field name="model">approval.step</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="res_model"/>
                <field name="role"/>
                <field name="name"/>
                <field name="group_id"/>
                <field name="notify"/>
            </list>
        </field>
    </record>

    <record id="approval_step_action" model="ir.actions.act_window">
        <field name="name">Payslip Approval Roles</field>
        <field name="res_model">approval.step</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_approval_step" name="Payslip Approval Roles"
              parent="base.menu_administration" action="approval_step_action"
              sequence="95" groups="base.group_system"/>
</odoo>
