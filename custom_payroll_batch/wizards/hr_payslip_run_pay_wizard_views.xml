<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_payslip_run_pay_wizard_form" model="ir.ui.view">
        <field name="name">hr.payslip.run.pay.wizard.form</field>
        <field name="model">hr.payslip.run.pay.wizard</field>
        <field name="arch" type="xml">
            <form string="دفع رواتب الباتش">
                <group>
                    <field name="payslip_run_id" invisible="1"/>
                    <field name="journal_id"/>
                    <field name="payment_date"/>
                </group>
                <div class="mb-2">
                    <button name="action_select_all" type="object"
                            string="تحديد الكل" class="btn-secondary"/>
                    <button name="action_unselect_all" type="object"
                            string="إلغاء تحديد الكل" class="btn-secondary"/>
                </div>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="employee_id"/>
                        <field name="amount"/>
                        <field name="to_pay"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object"
                            string="تأكيد الدفع" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
