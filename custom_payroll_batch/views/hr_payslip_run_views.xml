<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        الفورم الأصلي (hr_payroll.hr_payslip_run_form) بسيط جدًا:
        <form string="Pay Runs" js_class="hr_payslip_batch_form">
            <group> ... company_id / structure_id / schedule_pay / date_start / date_end ... </group>
        </form>
        مفيش <header> ولا <sheet> في الـ base view نفسها (الأزرار التانية بتتحقن من موديولات تانية
        بنفس الطريقة - عن طريق views موروثة). فعشان كده بنحط الأزرار في <header> جديد قبل الـ <group>.
    -->
    <record id="view_hr_payslip_run_form_custom_buttons" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.custom.buttons</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <header>
                    <button name="action_open_generate_wizard" type="object"
                            string="توليد رواتب (تحديد أيام العمل)"
                            class="btn-secondary"
                            invisible="state != '01_ready'"/>
                    <button name="action_open_pay_wizard" type="object"
                            string="Pay"
                            class="btn-primary"
                            invisible="state != '02_close'"/>
                </header>
            </xpath>
        </field>
    </record>

</odoo>
